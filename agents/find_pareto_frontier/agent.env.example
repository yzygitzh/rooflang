# Copy this file outside the repository, fill in one provider's credentials,
# and pass it with run-agent.sh --env-file /path/to/agent.env.
# Never commit a populated copy.

# Codex with API-key authentication:
OPENAI_API_KEY=

# Claude Code with API-key authentication:
ANTHROPIC_API_KEY=

# Or use a non-interactive Claude Code OAuth token instead of ANTHROPIC_API_KEY:
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional provider/gateway and proxy settings must be placed here explicitly;
# host settings are not inherited. Examples include OPENAI_BASE_URL,
# ANTHROPIC_BASE_URL, HTTPS_PROXY, and NO_PROXY.
